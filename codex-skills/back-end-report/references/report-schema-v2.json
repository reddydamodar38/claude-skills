{
    "$schema":  "http://json-schema.org/draft-07/schema#",
    "$id":  "back-end-report-v2",
    "title":  "Back-End Report canonical data v2",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "generated_utc",
                     "runs",
                     "report"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  "2.0"
                                          },
                       "generated_utc":  {
                                             "type":  "string",
                                             "format":  "date-time"
                                         },
                       "runs":  {
                                    "type":  "object",
                                    "additionalProperties":  false,
                                    "required":  [
                                                     "baseline",
                                                     "current"
                                                 ],
                                    "properties":  {
                                                       "baseline":  {
                                                                        "$ref":  "#/definitions/run"
                                                                    },
                                                       "current":  {
                                                                       "$ref":  "#/definitions/run"
                                                                   }
                                                   }
                                },
                       "report":  {
                                      "type":  "object",
                                      "additionalProperties":  false,
                                      "required":  [
                                                       "limitations",
                                                       "node_summary",
                                                       "server_comparison",
                                                       "gc_comparison",
                                                       "smaps_end",
                                                       "config_changes",
                                                       "database_summary",
                                                       "sql_comparison",
                                                       "awr_summary",
                                                       "instance_summary",
                                                       "ndump_summary",
                                                       "cmb_summary",
                                                       "artifact_coverage",
                                                       "errors_warnings",
                                                       "details",
                                                       "executive_summary"
                                                   ],
                                      "properties":  {
                                                         "limitations":  {
                                                                             "type":  "array",
                                                                             "items":  {
                                                                                           "type":  "string"
                                                                                       }
                                                                         },
                                                         "node_summary":  {
                                                                              "type":  "array",
                                                                              "items":  {
                                                                                            "type":  "object"
                                                                                        }
                                                                          },
                                                         "server_comparison":  {
                                                                                   "type":  "array",
                                                                                   "items":  {
                                                                                                 "$ref":  "#/definitions/assessedRow"
                                                                                             }
                                                                               },
                                                         "gc_comparison":  {
                                                                               "type":  "array",
                                                                               "items":  {
                                                                                             "$ref":  "#/definitions/assessedRow"
                                                                                         }
                                                                           },
                                                         "smaps_end":  {
                                                                           "type":  "array",
                                                                           "items":  {
                                                                                         "$ref":  "#/definitions/assessedRow"
                                                                                     }
                                                                       },
                                                         "config_changes":  {
                                                                                "type":  "array",
                                                                                "items":  {
                                                                                              "type":  "object"
                                                                                          }
                                                                            },
                                                         "database_summary":  {
                                                                                  "type":  "array",
                                                                                  "items":  {
                                                                                                "$ref":  "#/definitions/assessedRow"
                                                                                            }
                                                                              },
                                                         "sql_comparison":  {
                                                                                "type":  "array",
                                                                                "items":  {
                                                                                              "$ref":  "#/definitions/assessedRow"
                                                                                          }
                                                                            },
                                                         "awr_summary":  {
                                                                             "type":  "array",
                                                                             "items":  {
                                                                                           "$ref":  "#/definitions/assessedRow"
                                                                                       }
                                                                         },
                                                         "instance_summary":  {
                                                                                  "type":  "array",
                                                                                  "items":  {
                                                                                                "$ref":  "#/definitions/assessedRow"
                                                                                            }
                                                                              },
                                                         "ndump_summary":  {
                                                                               "type":  "array",
                                                                               "items":  {
                                                                                             "$ref":  "#/definitions/assessedRow"
                                                                                         }
                                                                           },
                                                         "cmb_summary":  {
                                                                             "type":  "array",
                                                                             "items":  {
                                                                                           "$ref":  "#/definitions/assessedRow"
                                                                                       }
                                                                         },
                                                         "artifact_coverage":  {
                                                                                   "type":  "array",
                                                                                   "items":  {
                                                                                                 "type":  "object"
                                                                                             }
                                                                               },
                                                         "errors_warnings":  {
                                                                                 "type":  "array",
                                                                                 "items":  {
                                                                                               "type":  "object"
                                                                                           }
                                                                             },
                                                         "details":  {
                                                                         "type":  "array",
                                                                         "items":  {
                                                                                       "type":  "object"
                                                                                   }
                                                                     },
                                                         "executive_summary":  {
                                                                                   "type":  "object",
                                                                                   "additionalProperties":  false,
                                                                                   "required":  [
                                                                                                    "overall_status",
                                                                                                    "top_regressions",
                                                                                                    "improvements",
                                                                                                    "plan_changes",
                                                                                                    "new_errors",
                                                                                                    "config_correlations",
                                                                                                    "limitations_routes"
                                                                                                ],
                                                                                   "properties":  {
                                                                                                      "overall_status":  {
                                                                                                                             "type":  "string",
                                                                                                                             "minLength":  1
                                                                                                                         },
                                                                                                      "top_regressions":  {
                                                                                                                              "type":  "array",
                                                                                                                              "items":  {
                                                                                                                                            "type":  "string"
                                                                                                                                        }
                                                                                                                          },
                                                                                                      "improvements":  {
                                                                                                                           "type":  "array",
                                                                                                                           "items":  {
                                                                                                                                         "type":  "string"
                                                                                                                                     }
                                                                                                                       },
                                                                                                      "plan_changes":  {
                                                                                                                           "type":  "array",
                                                                                                                           "items":  {
                                                                                                                                         "type":  "string"
                                                                                                                                     }
                                                                                                                       },
                                                                                                      "new_errors":  {
                                                                                                                         "type":  "array",
                                                                                                                         "items":  {
                                                                                                                                       "type":  "string"
                                                                                                                                   }
                                                                                                                     },
                                                                                                      "config_correlations":  {
                                                                                                                                  "type":  "array",
                                                                                                                                  "items":  {
                                                                                                                                                "type":  "string"
                                                                                                                                            }
                                                                                                                              },
                                                                                                      "limitations_routes":  {
                                                                                                                                 "type":  "array",
                                                                                                                                 "items":  {
                                                                                                                                               "type":  "string"
                                                                                                                                           }
                                                                                                                             }
                                                                                                  }
                                                                               }
                                                     }
                                  }
                   },
    "definitions":  {
                        "run":  {
                                    "type":  "object",
                                    "additionalProperties":  false,
                                    "required":  [
                                                     "path",
                                                     "nodes"
                                                 ],
                                    "properties":  {
                                                       "path":  {
                                                                    "type":  "string",
                                                                    "minLength":  1
                                                                },
                                                       "nodes":  {
                                                                     "type":  "array",
                                                                     "items":  {
                                                                                   "$ref":  "#/definitions/node"
                                                                               }
                                                                 }
                                                   }
                                },
                        "node":  {
                                     "type":  "object",
                                     "additionalProperties":  false,
                                     "required":  [
                                                      "name",
                                                      "files"
                                                  ],
                                     "properties":  {
                                                        "name":  {
                                                                     "type":  "string",
                                                                     "minLength":  1
                                                                 },
                                                        "files":  {
                                                                      "type":  "array",
                                                                      "items":  {
                                                                                    "$ref":  "#/definitions/file"
                                                                                }
                                                                  }
                                                    }
                                 },
                        "file":  {
                                     "type":  "object",
                                     "additionalProperties":  false,
                                     "required":  [
                                                      "relative_path",
                                                      "category",
                                                      "length",
                                                      "last_write_utc"
                                                  ],
                                     "properties":  {
                                                        "relative_path":  {
                                                                              "type":  "string",
                                                                              "minLength":  1
                                                                          },
                                                        "category":  {
                                                                         "type":  "string",
                                                                         "minLength":  1
                                                                     },
                                                        "length":  {
                                                                       "type":  "integer",
                                                                       "minimum":  0
                                                                   },
                                                        "last_write_utc":  {
                                                                               "type":  "string",
                                                                               "format":  "date-time"
                                                                           }
                                                    }
                                 },
                        "assessment":  {
                                           "type":  "object",
                                           "additionalProperties":  false,
                                           "required":  [
                                                            "severity",
                                                            "confidence",
                                                            "evidence",
                                                            "likely_cause",
                                                            "route"
                                                        ],
                                           "properties":  {
                                                              "severity":  {
                                                                               "enum":  [
                                                                                            "None",
                                                                                            "Low",
                                                                                            "Medium",
                                                                                            "High"
                                                                                        ]
                                                                           },
                                                              "confidence":  {
                                                                                 "enum":  [
                                                                                              "Low",
                                                                                              "Medium",
                                                                                              "High"
                                                                                          ]
                                                                             },
                                                              "evidence":  {
                                                                               "type":  "array",
                                                                               "minItems":  1,
                                                                               "items":  {
                                                                                             "type":  "string",
                                                                                             "minLength":  1
                                                                                         }
                                                                           },
                                                              "likely_cause":  {
                                                                                   "type":  "string",
                                                                                   "minLength":  1
                                                                               },
                                                              "route":  {
                                                                            "type":  "string",
                                                                            "minLength":  1
                                                                        }
                                                          }
                                       },
                        "assessedRow":  {
                                            "type":  "object",
                                            "required":  [
                                                             "source_paths",
                                                             "assessment"
                                                         ],
                                            "properties":  {
                                                               "source_paths":  {
                                                                                    "type":  "array",
                                                                                    "minItems":  1,
                                                                                    "items":  {
                                                                                                  "type":  "string",
                                                                                                  "pattern":  "^(baseline|current):"
                                                                                              }
                                                                                },
                                                               "assessment":  {
                                                                                  "$ref":  "#/definitions/assessment"
                                                                              }
                                                           }
                                        }
                    }
}
